# ============================================================================
# Configuración del taller. Copiar a .env y editar.
# ============================================================================
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# Un solo .env para todo: lo leen el código Python de src/paso*, los notebooks
# y el contenedor del backend. El .env NO se versiona (está en .gitignore).
# ============================================================================


# ============================================================================
# QUÉ MODELO USAR
# ============================================================================
# La convención es **proveedor:modelo**. Un solo string dice las dos cosas, así
# que cambiar de modelo —y de proveedor— es cambiar esta línea y nada más.
#
# **Es la única variable de modelo que se toca.** La página, el backend, los
# notebooks y los cinco pasos leen todos de aquí: `OLLAMA_MODEL`, más abajo,
# se deduce de esta cuando el proveedor es ollama.
#
# El modelo tiene que existir EN EL DESTINO ACTIVO (ver OLLAMA_DESTINO abajo).
# Qué hay en cada destino se consulta, no se adivina:
#   curl <la URL del destino>/api/tags
#
# --- el del taller ----------------------------------------------------------
#   ollama:qwen3.5:9b                    6.6 GB   TODAS las mediciones del
#                                                 material están hechas con
#                                                 este, y es el que tiene que
#                                                 estar en el destino activo
#
#   Dos copias de la MISMA etiqueta pueden ser archivos distintos, con otro
#   digest y otro tamaño. Si tus números no coinciden con los del material,
#   empieza por ahí.
#
# --- los de pago, si sus claves están más abajo -----------------------------
#   azure:mi-deployment-gpt41mini                  Azure OpenAI
#   foundry:mi-deployment-mistral-large            Azure AI Foundry
#   mistral:mistral-large-latest                   api.mistral.ai
#
# Al cambiar de modelo, vuelve a correr `python scripts/smoke_test_tools.py`:
# que un modelo haga tool calling no se hereda del anterior, y es el requisito
# del que cuelga todo el taller.
#
CHAT_MODEL=ollama:qwen3.5:9b

# Parámetros comunes a todos los proveedores.
TEMPERATURE=0
# Tope de tokens de la respuesta. Ollama lo ignora en algunos modelos.
NUM_PREDICT=2048


# ============================================================================
# OLLAMA — cuál de las tres direcciones se usa
# ============================================================================
# Las tres están declaradas aquí abajo y conviven. Para moverse entre ellas se
# cambia UNA palabra: la de OLLAMA_DESTINO. Las otras dos no se pierden y no
# hay que volver a averiguarlas.
#
#   localhost   Ollama corre en ESTA máquina. Es lo del instructor cuando
#               sirve el modelo desde su propia laptop, y lo de cualquiera que
#               trabaje solo.
#
#   aula        La laptop del instructor, vista desde la red del salón. Es lo
#               que pone un asistente durante el taller.
#
#               La IP de abajo NO se edita a mano: la escribe
#               scripts/fijar_ip_aula.py, y los `aula-up` lo llaman solos al
#               levantar Ollama. La asigna el DHCP y cambia sola, a veces
#               dentro de la misma sesión, así que a mano envejece mal.
#               Para verla sin tocar nada:
#                 python scripts/fijar_ip_aula.py --mostrar
#
#   tec         Un servidor con GPU en la red de la institución, por la
#               VPN. La dirección la da quien lo administra y va en el `.env`,
#               nunca aquí: este archivo se publica.
#
# Tiene que ser http://, NUNCA https:// — Ollama no hace TLS, y el error que
# da menciona "SSL" y manda a cualquiera a investigar certificados veinte
# minutos.
OLLAMA_DESTINO=localhost

# localhost se queda con valor: no es dato de nadie, y es lo que hace que un
# clon recién bajado funcione sin editar nada. Las otras dos van vacías a
# propósito —son direcciones de máquinas reales y este archivo se publica—, y
# cada quien las llena en su `.env`. El formato es  http://<ip>:11434
#
# Si eliges un destino cuya URL está vacía, el error te dice exactamente eso y
# lista los destinos que sí tienen dirección.
OLLAMA_URL_LOCALHOST=http://localhost:11434
OLLAMA_URL_AULA=
OLLAMA_URL_TEC=

# Antes la única línea era esta, y sigue funcionando: si OLLAMA_DESTINO está
# vacío, se usa lo que diga, y como variable de entorno es el escape para un
# caso suelto sin editar el archivo:
#   OLLAMA_BASE_URL=http://otra-maquina:11434
#
# Lo que YA NO hace es ganarle a OLLAMA_DESTINO. Antes sí, y eso rompió dos
# notebooks: el kernel de Jupyter traía una OLLAMA_BASE_URL vieja, inyectada al
# arrancar desde una versión anterior de este archivo, y mandaba en silencio con
# OLLAMA_DESTINO puesto en otra cosa. Ahora la línea de arriba manda, y si hay
# una OLLAMA_BASE_URL suelta los notebooks imprimen que la están ignorando.

# Esta línea ya NO hace falta y por eso está comentada: el modelo sale de
# CHAT_MODEL, arriba. Descomentarla solo sirve para un `.env` viejo que no
# tenga CHAT_MODEL; si la pones y contradice a CHAT_MODEL, gana CHAT_MODEL.
#
# Tenerla activa con otro valor fue un error real: Docker Compose la metía en
# el contenedor como variable de entorno y la página acababa pidiendo un
# modelo distinto del que pedían los notebooks.
# OLLAMA_MODEL=qwen3.5:9b

# Ventana de contexto que Ollama le asigna al modelo.
#
# OJO: qwen3.5:9b declara 262144 tokens, pero Ollama asigna 4096 por omisión y
# **trunca en silencio** al pasarse. Subirlo cuesta VRAM (el KV cache sale de
# ahí) y en la RTX 4060 quedan ~1.3 GB libres con el modelo cargado. Ver
# planeacion/hallazgos.md.
NUM_CTX=4096


# ============================================================================
# AZURE OPENAI
# ============================================================================
# El endpoint es el del recurso, sin la ruta: https://<recurso>.openai.azure.com
# El nombre del deployment va en CHAT_MODEL, después de "azure:".
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_API_VERSION=2025-01-01-preview
# Solo para que la página lo liste en el selector de modelos.
AZURE_DEPLOYMENT=


# ============================================================================
# AZURE AI FOUNDRY — Mistral Large y otros modelos servidos ahí
# ============================================================================
# El endpoint serverless que da la consola. Funciona con o sin el /v1 al final.
FOUNDRY_MISTRAL_ENDPOINT=
FOUNDRY_MISTRAL_KEY=
FOUNDRY_MISTRAL_DEPLOYMENT=


# ============================================================================
# MISTRAL — la API directa de api.mistral.ai
# ============================================================================
MISTRAL_API_KEY=
MISTRAL_MODEL=
# MISTRAL_BASE_URL=https://api.mistral.ai


# ============================================================================
# EL BACKEND DEL TALLER
# ============================================================================
# Corre en TU laptop, no en la del instructor: cada quien tiene su tablero.
BACKEND_URL=http://localhost:8000

# Tope de vueltas del bucle agéntico. Es el guardrail del paso 4 y lo que
# salva la demo del bucle infinito.
MAX_ITERACIONES=8
