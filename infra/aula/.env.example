# ============================================================================
# AULA — solo la máquina del instructor. Copiar a .env
# ============================================================================

# El modelo del taller. Si el smoke test de tool calling falla
# (scripts/smoke_test_tools.py), el plan B es qwen3:8b o llama3.1:8b.
OLLAMA_MODEL=qwen3.5:9b

# Ranuras de inferencia concurrentes. Subirlo no da capacidad gratis: quedan
# ~1.5 GB de VRAM libres después del modelo y cada ranura consume KV cache.
# Con más asistentes conviene BAJARLO y aceptar la cola, no subirlo.
OLLAMA_NUM_PARALLEL=4
